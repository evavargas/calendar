# Frontend (Vue)
# true  = mocks in the browser (no API)
# false = talk to Spring Boot (use Vite proxy /api → :8080)
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=

# When API is running locally with Vite proxy:
# VITE_USE_MOCK_API=false
# VITE_API_BASE_URL=

# When API is deployed:
# VITE_USE_MOCK_API=false
# VITE_API_BASE_URL=https://kairo-api-xxxxx.run.app
