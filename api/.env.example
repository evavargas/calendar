# Backend (api/) — local defaults use H2 + mock Google login
DATABASE_URL=jdbc:h2:mem:kairo;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/google/callback
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
KAIRO_AUTH_MOCK=true
KAIRO_TOKEN_SECRET=local-dev-token-secret-32b!!
COOKIE_SECURE=false

# --- Neon (paso 1) ---
# Neon te da:  postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Spring necesita JDBC:
#
# DATABASE_URL=jdbc:postgresql://HOST/DB?sslmode=require
# DATABASE_USERNAME=USER
# DATABASE_PASSWORD=PASSWORD
#
# Ejemplo de forma (sin secrets):
# DATABASE_URL=jdbc:postgresql://ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_USERNAME=neondb_owner
# DATABASE_PASSWORD=pegá-la-de-Neon-acá
#
# Guardá esto en api/.env.local (gitignored), no en el repo.
